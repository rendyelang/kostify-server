generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model complaints {
  complaint_id Int               @id @default(autoincrement())
  tenant_id    Int?
  owner_id     Int?
  title        String?           @db.VarChar
  message      String?           @db.VarChar
  created_at   DateTime?         @default(now()) @db.Timestamp(6)
  status       complaint_status?
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model notifications {
  notif_id   Int         @id @default(autoincrement())
  owner_id   Int?
  tenant_id  Int?
  title      String?     @db.VarChar
  message    String?     @db.VarChar
  type       notif_type?
  created_at DateTime    @default(now()) @db.Timestamptz(6)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model owners {
  owner_id Int     @id @default(autoincrement())
  name     String  @db.VarChar
  email    String  @unique @db.VarChar
  password String  @db.VarChar
  phone    String? @db.VarChar
  gender   gender?
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model payments {
  payment_id   Int             @id @default(autoincrement())
  tenant_id    Int?
  amount       Float?          @db.Real
  payment_date DateTime?       @db.Date
  method       String?         @db.VarChar
  status       payment_status?
  proof_url    String?         @db.VarChar
  period_month Int?
  period_year  Int?
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model rooms {
  room_id     Int         @id @default(autoincrement())
  owner_id    Int
  room_name   String      @db.VarChar
  price       Float       @db.Real
  status      room_status
  facilities  String      @db.VarChar
  description String?     @db.VarChar
  image_url   String[]
  floor       Int?
  capacity    Int?
  tenants     tenants[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model tenants {
  tenant_id        Int           @id @default(autoincrement())
  owner_id         Int
  room_id          Int
  name             String?       @db.VarChar
  email            String?       @db.VarChar
  password         String?       @db.VarChar
  phone            String?       @db.VarChar
  status           tenant_status
  emergency_number String?       @db.VarChar
  birth_place      String?       @db.VarChar
  birth_date       DateTime?     @db.Date
  address          String?
  created_at       DateTime?     @default(now()) @db.Timestamptz(6)
  entry_date       DateTime      @default(dbgenerated("CURRENT_DATE")) @db.Date
  rooms            rooms?        @relation(fields: [room_id], references: [room_id]) 
}

enum complaint_status {
  pending
  solved
}

enum notif_type {
  reminder
  broadcast
}

enum payment_status {
  paid
  unpaid
}

enum room_status {
  full
  empty
}

enum tenant_status {
  active
  inactive
}

enum gender {
  male
  female
}
